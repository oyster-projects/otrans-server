# 请改成 16-128 位字母、数字、下划线或短横线。
OTRANS_ADMIN_TOKEN=replace-with-a-long-random-token

# 直接运行二进制时使用；Docker 镜像会覆盖为 :8080 和 /data。
OTRANS_LISTEN_ADDR=:8080
OTRANS_DATA_DIR=./data

# 单文件最大 4 GiB，总 Blob 配额 100 GiB。
OTRANS_MAX_UPLOAD_BYTES=4294967296
OTRANS_MAX_STORAGE_BYTES=107374182400

# 已提交内容超过该天数后全端同步删除；0 表示关闭。
OTRANS_RETENTION_DAYS=30
